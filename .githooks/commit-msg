#!/bin/sh
# Conventional Commits guard. Installed by scripts/install-hooks.sh.

msg_file="$1"
[ -n "$msg_file" ] || exit 0

subject=$(head -n 1 "$msg_file")

# Allow merge/revert/fixup commits generated by git.
case "$subject" in
  Merge*|Revert*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{3,}'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
Invalid commit message.

Format: type(scope): imperative summary

Types: feat fix docs style refactor perf test build ci chore revert

Examples:
  feat(notes): add offline draft queue
  fix(auth): expire sessions after 30m idle
  docs(readme): document the bootstrap flow

One logical change per commit. Put the "why" in the body.
EOF
  exit 1
fi

if [ ${#subject} -gt 72 ]; then
  printf 'Commit subject is %d chars; keep it <=72.\n' "${#subject}" >&2
  exit 1
fi

exit 0
