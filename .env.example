# Local Matrix — environment variables (reference; never commit real values)
# Copy to .env per app/package and adjust. See project/05-plan/tasks/T-002-local-infra.md.

# Root
NODE_ENV=development

# apps/api — HTTP
PORT=3001

# Local Docker stack bootstrap (infra/docker/compose.dev.yml) — keep in sync
# with the DATABASE_URL below.
POSTGRES_USER=local_matrix
POSTGRES_PASSWORD=local_matrix
POSTGRES_DB=local_matrix

# Postgres (pooled at runtime, direct for migrations; identical locally)
DATABASE_URL=postgresql://local_matrix:local_matrix@127.0.0.1:15432/local_matrix
DIRECT_URL=postgresql://local_matrix:local_matrix@127.0.0.1:15432/local_matrix

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Local Mailpit SMTP catch-all (dev)
SMTP_URL=smtp://127.0.0.1:1025
