{
  "name": "local-matrix",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time location and sensor intelligence, on one map.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "hooks": "./scripts/install-hooks.sh",
    "db:up": "sh -c 'test -f .env || (echo \"(env) creating .env from .env.example\"; cp .env.example .env); exec docker compose -f infra/docker/compose.dev.yml --project-directory . --env-file .env up -d --wait'",
    "db:down": "sh -c 'exec docker compose -f infra/docker/compose.dev.yml --project-directory . --env-file .env down'",
    "db:reset": "sh -c 'exec docker compose -f infra/docker/compose.dev.yml --project-directory . --env-file .env down -v'"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@swc/core", "prisma", "@prisma/engines", "@prisma/client"]
  }
}
