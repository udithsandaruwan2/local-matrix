# Local Matrix — environment variables (reference; never commit real values)
# Copy to .env per app/package and adjust. See project/05-plan/tasks/T-002-local-infra.md.

# Root
NODE_ENV=development

# apps/api — HTTP
PORT=3001

# Postgres (pooled at runtime, direct for migrations; identical locally)
DATABASE_URL=postgresql://local_matrix:local_matrix@localhost:5432/local_matrix
DIRECT_URL=postgresql://local_matrix:local_matrix@localhost:5432/local_matrix

# Redis
REDIS_URL=redis://localhost:6379

# Local SMTP (Mailpit) — dev only
SMTP_URL=smtp://localhost:1025
